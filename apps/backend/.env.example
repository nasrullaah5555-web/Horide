# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Local database (see infra/). Production value comes from the hosting provider's secret settings.
DATABASE_URL=postgres://horide:horide_local_dev@localhost:5432/horide
DATABASE_SSL=false
# Connections per API instance (keep under the database plan's connection limit).
DATABASE_POOL_MAX=10

# Comma-separated list of browser origins allowed to call the API (admin dashboard, website).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Proxies in front of the API that add to X-Forwarded-For: 1 for Render alone, 2 for Cloudflare + Render.
TRUST_PROXY_HOPS=1

# Development adapters. Production refuses to start with these values.
SMS_PROVIDER=console
ROUTING_PROVIDER=dev_estimate
STORAGE_PROVIDER=local

# Secrets. These example values are for LOCAL DEVELOPMENT ONLY; production refuses them.
# Generate real ones with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000
OTP_PEPPER=dev-only-otp-pepper-change-me-00000000000000
QUOTE_SIGNING_SECRET=dev-only-quote-secret-change-me-00000000000
ADMIN_TOTP_ENCRYPTION_KEY=ZGV2LW9ubHktdG90cC1rZXktY2hhbmdlLW1lLTAwMDA=

# Push notifications: 'log' (development) or 'fcm' (production, needs Firebase — owner action OA-11)
PUSH_PROVIDER=log
